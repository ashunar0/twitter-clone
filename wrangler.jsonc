/**
 * Cloudflare Workers 設定。1 Worker で FE 静的 (assets) + BE API (fetch handler) を同一 origin 配信する。
 *
 * - main: fetch handler (API 用)。/api/* だけがこの Worker まで届く
 * - assets: Vite build output (dist/) を配信。not_found_handling=single-page-application で SPA fallback
 * - d1_databases: DB binding (env.DB として渡る)
 * - r2_buckets: MEDIA_BUCKET (image / attachment 保存)。事前に `wrangler r2 bucket create twitter-clone-media` が必要
 * - vars.MEDIA_PUBLIC_URL: R2 public bucket の base URL。開発環境は tsx (Node) 側で無視される (public/dev-uploads/ を Vite が serve)
 *
 * database_id は初期は placeholder、`wrangler d1 create twitter-clone` の出力で置き換える
 */
{
  "name": "twitter-clone",
  "main": "server/worker.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "twitter-clone",
      "database_id": "3268c4a2-f271-4282-bdb8-5a627bfb2f9e",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "twitter-clone-media"
    }
  ],
  "vars": {
    "MEDIA_PUBLIC_URL": "https://pub-REPLACE-WITH-R2-PUBLIC-ID.r2.dev"
  }
}
